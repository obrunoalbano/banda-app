// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Banda (tenant). Todo dado de negócio pertence a uma banda; o acesso é por BandMember (User × Band).
model Band {
  id                     String         @id @default(cuid())
  name                   String
  /// Contato da banda (cadastro). Quem entra no app são os User via BandMember.
  responsible            String
  phone                  String
  /// LEGADO (antes de multi-bandas a banda era a conta). Migrado para User; não usar. Remover num próximo deploy.
  email                  String?        @unique
  /// LEGADO — ver `email`.
  passwordHash           String?
  /// Identificador público (URL da agenda: /b/<slug>). Editável; trocar quebra widgets instalados.
  slug                   String         @unique
  /// Opt-in: agenda pública (página /b/<slug>, widget e API pública de shows).
  publicAgendaEnabled    Boolean        @default(false)
  /// Opt-in: formulário de contato público (página /b/<slug>/contato, widget e POST público).
  leadFormEnabled        Boolean        @default(false)
  /// Origens (https://dominio) autorizadas a enviar o formulário direto do navegador (CORS).
  leadAllowedOrigins     String[]       @default([])
  /// Banda desativada por um superadmin: ninguém acessa (sessões abertas perdem o acesso na hora).
  disabledAt             DateTime?
  /// LEGADO — ver `email`.
  mustChangePassword     Boolean        @default(false)
  /// SHA-256 (hex) do token de ingestão de leads. O token em si nunca é persistido.
  leadIngestTokenHash    String?        @unique
  /// LEGADO — ver `email`.
  passwordResetTokenHash String?        @unique
  /// LEGADO — ver `email`.
  passwordResetExpiresAt DateTime?
  /// Link de convite da banda (reutilizável, para o grupo): parte pública do token. O link só vale
  /// com a assinatura HMAC (AUTH_SECRET) — vazar o banco não vaza links. Vazio = link desativado.
  inviteLinkNonce        String?        @unique
  /// Acesso de quem entra pelo link da banda.
  inviteLinkRole         BandRole       @default(VIEWER)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  venues                 Venue[]
  shows                  Show[]
  leads                  Lead[]
  deals                  Deal[]
  financeEntries         FinanceEntry[]
  members                BandMember[]
  repertoires            Repertoire[]
  rehearsals             Rehearsal[]
}

/// Pessoa que entra no app (email + senha). Acessa N bandas via BandMember.
model User {
  id                     String       @id @default(cuid())
  name                   String
  email                  String       @unique
  phone                  String?
  passwordHash           String
  /// Conta desativada por um superadmin: não faz login e sessões ativas deixam de valer.
  disabledAt             DateTime?
  /// Senha provisória (criada/redefinida por superadmin): obriga a trocar no próximo acesso.
  mustChangePassword     Boolean      @default(false)
  /// "Esqueci minha senha": SHA-256 (hex) do token enviado por email (o token nunca é salvo). Um por vez; uso único.
  passwordResetTokenHash String?      @unique
  passwordResetExpiresAt DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  memberships            BandMember[]
}

/// Papel do integrante na banda: ADMIN altera tudo (inclusive integrantes); VIEWER só visualiza.
enum BandRole {
  ADMIN
  VIEWER
}

/// Integrante da banda com acesso ao app. `userId` vazio = convite pendente (a pessoa ainda não tem conta).
model BandMember {
  id              String    @id @default(cuid())
  bandId          String
  band            Band      @relation(fields: [bandId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  /// Email do convite (minúsculo). Com conta vinculada, o email de login é o do User.
  email           String
  role            BandRole  @default(VIEWER)
  /// Convite pendente: SHA-256 do token do link (o token nunca é salvo). Limpo ao aceitar.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  /// Quando passou a ter acesso (conta vinculada).
  joinedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rehearsalAttendances RehearsalAttendance[]

  @@unique([bandId, email])
  @@unique([bandId, userId])
  @@index([userId])
}

enum VenueSendStatus {
  NAO_ENVIADO
  ENVIADO
  FINALIZADO
}

enum ShowPaymentStatus {
  PAGO
  AGUARDANDO_PAGAMENTO
}

model Venue {
  id              String          @id @default(cuid())
  bandId          String
  band            Band            @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name            String
  responsible     String
  phone           String
  email           String
  city            String
  state           String
  /// Cachê de referência da casa, em centavos (R$ 1.500,00 = 150000).
  valorCacheCents Int?
  instagram       String?
  sendStatus      VenueSendStatus @default(NAO_ENVIADO)
  /// Palco do diretório (Explorar Palcos) de onde a casa veio. Uma banda não adiciona o mesmo palco duas vezes.
  stageId         String?
  stage           Stage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shows           Show[]
  deals           Deal[]

  @@unique([bandId, stageId])
  @@index([bandId, updatedAt])
  @@index([bandId, city])
  @@index([stageId])
}

model Show {
  id                  String            @id @default(cuid())
  bandId              String
  band                Band              @relation(fields: [bandId], references: [id], onDelete: Cascade)
  venueId             String?
  /// NoAction: uma casa com shows não pode ser apagada (preserva o histórico).
  /// Não usar Restrict: bloquearia o cascade Band → Venue/Show na mesma instrução.
  venue               Venue?            @relation(fields: [venueId], references: [id], onDelete: NoAction)
  privateEventDetails String?
  privateCity         String?
  privateState        String?
  /// Cachê do show em centavos. Snapshot: não muda se o cachê da casa mudar depois.
  cacheCents          Int?
  date                DateTime
  time                String
  paymentStatus       ShowPaymentStatus @default(AGUARDANDO_PAGAMENTO)
  /// Vencimento do cachê (data pura). Vazio = vence na data do show.
  paymentDueDate      DateTime?
  /// Data em que o cachê foi recebido (data pura). Preenchida ao marcar como pago.
  paidAt              DateTime?
  /// Aparece na agenda pública. Padrão definido na API: show em casa = true, evento particular = false.
  isPublic            Boolean           @default(false)
  /// Link de ingressos exibido na agenda pública.
  ticketUrl           String?
  /// Show cancelado continua listado (como "Cancelado") em vez de sumir.
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  financeEntries      FinanceEntry[]

  @@index([bandId, date])
  @@index([venueId])
}

model Lead {
  id               String   @id @default(cuid())
  bandId           String
  band             Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name             String
  email            String
  whatsapp         String?
  eventDate        String?
  city             String?
  eventType        String?
  eventDescription String?
  metadata         Json?
  source           String?
  createdAt        DateTime @default(now())
  deals            Deal[]

  @@index([bandId, createdAt])
}

/// Usuário da equipe do produto (painel /admin). Separado de Band: não é cliente/tenant.
model AdminUser {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  /// Senha provisória: obriga a trocar no próximo acesso.
  mustChangePassword Boolean   @default(false)
  disabledAt         DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  stagesCreated      Stage[]   @relation("StageCreatedBy")
  stagesVerified     Stage[]   @relation("StageVerifiedBy")
}

enum StageType {
  BAR
  PUB
  CASA_DE_SHOW
  CENTRO_CULTURAL
  RESTAURANTE
  ESPACO_DE_EVENTOS
  TEATRO
  OUTRO
}

enum StageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Palco da base curada (Explorar Palcos). Global: não pertence a nenhuma banda.
/// Só canais INSTITUCIONAIS — nada de nome/telefone pessoal de responsável (LGPD).
model Stage {
  id             String      @id @default(cuid())
  name           String
  type           StageType
  city           String
  state          String
  /// Bairro/região dentro da cidade (opcional).
  neighborhood   String?
  /// Estilos que o palco costuma programar (ex.: "rock", "sertanejo").
  genres         String[]    @default([])
  instagram      String?
  website        String?
  /// Telefone comercial do estabelecimento.
  publicPhone    String?
  /// WhatsApp comercial do estabelecimento (canal de contato principal).
  whatsapp       String?
  publicEmail    String?
  capacity       Int?
  /// Link de ORIGEM da imagem (ex.: bucket da equipe). Nunca exibido — usado para (re)processar.
  imageUrl       String?
  /// Única imagem servida: miniatura WebP 400×300 no nosso storage. null = ainda não processada.
  imageThumbUrl  String?
  /// Última atividade conhecida (programação/música ao vivo). Quando a fonte só tem o ano, 1º/jan.
  lastActivityAt DateTime?
  /// Origem de importação em lote (ex.: "base-equipe") + id na origem — reimportar atualiza em vez de duplicar.
  externalSource String?
  externalId     String?
  /// O que programa, dias de música ao vivo, observações da curadoria.
  notes          String?
  /// De onde veio a informação (site, Instagram, ligação…) — para correções/remoções.
  sourceNote     String?
  status         StageStatus @default(DRAFT)
  verifiedAt     DateTime?
  verifiedBy     AdminUser?  @relation("StageVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById   String?
  createdBy      AdminUser?  @relation("StageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  /// Casas das bandas criadas a partir deste palco (sinal de interesse para a curadoria).
  venues         Venue[]
  /// Negociações de bandas com este palco (Fluxo de contatos).
  deals          Deal[]

  @@unique([externalSource, externalId])
  @@index([status, state, city])
  @@index([updatedAt])
}

/// Etapa do Fluxo de contatos (fixas por enquanto). Ordem do quadro = ordem aqui.
enum DealStep {
  PRIMEIRO_CONTATO
  PROPOSTA
  PERDEU
  GANHOU
}

/// De onde a negociação veio.
enum DealSource {
  CONTATO
  EXPLORADOR
}

/// Negociação no Fluxo de contatos (CRM simples): um contato (Lead) ou um palco do
/// Explorar Palcos acompanhado por etapas. No máximo uma por contato/palco por banda.
model Deal {
  id            String     @id @default(cuid())
  bandId        String
  band          Band       @relation(fields: [bandId], references: [id], onDelete: Cascade)
  step          DealStep   @default(PRIMEIRO_CONTATO)
  source        DealSource
  /// Origem CONTATO. SetNull: apagar o contato mantém a negociação (nome copiado em `name`).
  leadId        String?
  lead          Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Origem EXPLORADOR.
  stageId       String?
  stage         Stage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Casa criada quando a negociação foi ganha ("Adicionar às minhas casas").
  venueId       String?
  venue         Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Cópia do nome/cidade da origem no momento da inclusão (a origem pode ser apagada).
  name          String
  city          String?
  state         String?
  /// Observações da banda sobre a negociação (texto livre).
  notes         String?
  stepChangedAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([bandId, leadId])
  @@unique([bandId, stageId])
  @@index([bandId, step, stepChangedAt])
  @@index([leadId])
  @@index([stageId])
  @@index([venueId])
}

enum FinanceEntryType {
  RECEITA
  DESPESA
}

/// Categorias de lançamento. Quais valem para receita/despesa: lib/finance-categories.ts.
enum FinanceCategory {
  TRANSPORTE
  ALIMENTACAO
  HOSPEDAGEM
  SOM_E_LUZ
  MUSICO_FREELANCER
  EQUIPE
  COMISSAO
  EQUIPAMENTO
  ENSAIO
  DIVULGACAO
  TAXAS_E_IMPOSTOS
  CACHE_EXTRA
  MERCH
  PATROCINIO
  DIREITOS_AUTORAIS
  OUTROS
}

/// Lançamento financeiro (Financeiro → Lançamentos): receita ou despesa, avulsa ou de um show.
/// O cachê do show NÃO vira lançamento — fica em Show.cacheCents (sem duplicar).
model FinanceEntry {
  id          String           @id @default(cuid())
  bandId      String
  band        Band             @relation(fields: [bandId], references: [id], onDelete: Cascade)
  type        FinanceEntryType
  category    FinanceCategory
  description String
  amountCents Int
  /// Data do lançamento (data pura, UTC 00:00): competência/vencimento.
  date        DateTime
  /// Data em que foi pago/recebido (data pura). Vazio = pendente.
  paidAt      DateTime?
  /// Show relacionado (opcional). Apagar o show mantém o lançamento, sem vínculo.
  showId      String?
  show        Show?            @relation(fields: [showId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([bandId, date])
  @@index([showId])
}

/// Repertório da banda (módulo Administrativo): lista ordenada de músicas para ensaiar/tocar.
model Repertoire {
  id          String           @id @default(cuid())
  bandId      String
  band        Band             @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  songs       RepertoireSong[]
  rehearsals  Rehearsal[]

  @@index([bandId, name])
}

/// Música de um repertório. `position` = ordem na lista (0, 1, 2…). Dados do Spotify são uma cópia
/// (título/artistas editáveis); sem link, a banda preenche à mão.
model RepertoireSong {
  id              String               @id @default(cuid())
  repertoireId    String
  repertoire      Repertoire           @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  position        Int
  title           String
  artists         String?
  /// Link canônico https://open.spotify.com/track/<id> (normalizado no schema Zod).
  spotifyUrl      String?
  spotifyTrackId  String?
  /// Capa do álbum (só i.scdn.co, servida pelo Spotify).
  imageUrl        String?
  durationMs      Int?
  /// Observação curta (ex.: "toca em um tom a menos").
  notes           String?
  rehearsalChecks RehearsalSongCheck[]

  @@index([repertoireId, position])
}

enum RehearsalRecurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Ensaio da banda. `date` = data pura (UTC 00:00) do ensaio ou da 1ª ocorrência se recorrente;
/// o dia da semana/mês da recorrência sai dela. `time` = "HH:mm".
model Rehearsal {
  id              String                @id @default(cuid())
  bandId          String
  band            Band                  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  location        String
  date            DateTime
  time            String
  recurrence      RehearsalRecurrence   @default(NONE)
  /// Último dia da recorrência (data pura); vazio = sem fim.
  recurrenceUntil DateTime?
  repertoireId    String?
  repertoire      Repertoire?           @relation(fields: [repertoireId], references: [id], onDelete: SetNull)
  /// Ordem das músicas NESTE ensaio (ids de RepertoireSong). Vazio = ordem do repertório; músicas
  /// fora da lista vão para o fim e ids que não existem mais são ignorados (`orderRehearsalSongs`).
  songOrder       String[]              @default([])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  attendances     RehearsalAttendance[]
  songChecks      RehearsalSongCheck[]

  @@index([bandId, date])
}

enum AttendanceStatus {
  CONFIRMED
  DECLINED
}

/// Resposta de um integrante para UMA ocorrência do ensaio (sem registro = ainda não respondeu).
model RehearsalAttendance {
  id             String           @id @default(cuid())
  rehearsalId    String
  rehearsal      Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  memberId       String
  member         BandMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Data pura da ocorrência respondida.
  occurrenceDate DateTime
  status         AttendanceStatus
  respondedAt    DateTime         @default(now())

  @@unique([rehearsalId, memberId, occurrenceDate])
  @@index([memberId])
}

enum RehearsalSongStatus {
  REHEARSED
  MISSED
}

/// Música marcada como ensaiada ou que faltou em UMA ocorrência do ensaio (sem registro = sem marcação).
model RehearsalSongCheck {
  id             String              @id @default(cuid())
  rehearsalId    String
  rehearsal      Rehearsal           @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  songId         String
  song           RepertoireSong      @relation(fields: [songId], references: [id], onDelete: Cascade)
  /// Data pura da ocorrência.
  occurrenceDate DateTime
  status         RehearsalSongStatus
  updatedAt      DateTime            @updatedAt

  @@unique([rehearsalId, songId, occurrenceDate])
  @@index([songId])
}
