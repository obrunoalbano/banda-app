// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Band {
  id               String   @id @default(cuid())
  name             String
  responsible      String
  phone            String
  email            String   @unique
  passwordHash     String
  /// SHA-256 (hex) do token de ingestão de leads. O token em si nunca é persistido.
  leadIngestTokenHash String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  venues           Venue[]
  shows            Show[]
  leads            Lead[]
}

enum VenueSendStatus {
  NAO_ENVIADO
  ENVIADO
  FINALIZADO
}

enum ShowPaymentStatus {
  PAGO
  AGUARDANDO_PAGAMENTO
}

model Venue {
  id          String            @id @default(cuid())
  bandId      String
  band        Band              @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name        String
  responsible String
  phone       String
  email       String
  city        String
  state       String
  /// Cachê de referência da casa, em centavos (R$ 1.500,00 = 150000).
  valorCacheCents Int?
  instagram   String?
  sendStatus  VenueSendStatus   @default(NAO_ENVIADO)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  shows       Show[]

  @@index([bandId, updatedAt])
  @@index([bandId, city])
}

model Show {
  id              String             @id @default(cuid())
  bandId          String
  band            Band               @relation(fields: [bandId], references: [id], onDelete: Cascade)
  venueId         String?
  /// NoAction: uma casa com shows não pode ser apagada (preserva o histórico).
  /// Não usar Restrict: bloquearia o cascade Band → Venue/Show na mesma instrução.
  venue           Venue?             @relation(fields: [venueId], references: [id], onDelete: NoAction)
  privateEventDetails String?
  privateCity         String?
  privateState        String?
  /// Cachê do show em centavos. Snapshot: não muda se o cachê da casa mudar depois.
  cacheCents          Int?
  date            DateTime
  time            String
  paymentStatus   ShowPaymentStatus  @default(AGUARDANDO_PAGAMENTO)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([bandId, date])
  @@index([venueId])
}

model Lead {
  id          String   @id @default(cuid())
  bandId      String
  band        Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  name        String
  email       String
  whatsapp    String?
  eventDate   String?
  city        String?
  eventType   String?
  eventDescription String?
  metadata    Json?
  source      String?
  createdAt   DateTime @default(now())

  @@index([bandId, createdAt])
}
