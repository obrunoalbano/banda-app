DATABASE_URL="file:./dev.db"
# Supabase / Postgres: também DIRECT_URL (conexão direta) para prisma migrate quando usar prisma.config.ts.
# Se aparecer "self-signed certificate in certificate chain" no dev (proxy corporativo), só local:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Obrigatório para NextAuth (middleware e sessão). Gere: openssl rand -base64 32
AUTH_SECRET=""
# Opcional: origens permitidas para POST /api/leads/ingest no browser (CORS), vírgulas.
# LEADS_INGEST_ALLOWED_ORIGINS="https://meusite.com"
