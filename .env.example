# Postgres (Supabase). Runtime: pooler em modo TRANSACTION (porta 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma CLI (migrate): MESMO pooler em modo SESSION (porta 5432) — migrations não funcionam no modo transaction.
# Não use a conexão direta db.PROJECT_REF.supabase.co: ela é só IPv6 e falha com P1001 em redes sem IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Se aparecer "self-signed certificate in certificate chain" no dev (proxy corporativo), só local:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Tamanho do pool por instância (padrão: 3 na Vercel, 10 fora dela).
# DATABASE_POOL_MAX=3

# Obrigatório para NextAuth (proxy e sessão). Gere: openssl rand -base64 32
# ATENÇÃO: uma variável por linha, sempre com aspas fechadas.
AUTH_SECRET=""

# Opcional: URL pública da app (exibida na tela de integrações).
# NEXT_PUBLIC_APP_URL="https://minhabanda.com"
# Opcional: origens permitidas para POST /api/leads/ingest no browser (CORS), vírgulas.
# LEADS_INGEST_ALLOWED_ORIGINS="https://meusite.com"
