{
  "name": "banda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:local": "node scripts/local-db.mjs",
    "db:local:migrate": "node scripts/with-local-db.mjs prisma migrate deploy",
    "db:local:seed": "node scripts/local-seed.mjs",
    "dev:local": "node scripts/with-local-db.mjs next dev",
    "admin:create": "node scripts/create-superadmin.mjs",
    "stages:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-stages.mjs",
    "stages:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-stage-images.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.5.0",
    "@vercel/analytics": "2.0.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "1.48.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^7.5.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
